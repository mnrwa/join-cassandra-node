#!/bin/bash
# join-node.sh

set -euo pipefail

CLUSTER_NAME="MainDC"
DC="DC1"
RACK="RACK1"

KNOWN_NODES=(
    192.168.1.164
    192.168.1.165
    192.168.1.171
    192.168.1.178
    192.168.1.109
)

log() { echo "[$(date +%H:%M:%S)] $*"; }

if [ "$(id -u)" -ne 0 ]; then
    echo "Запускать от root"
    exit 1
fi

NODE_IP="${1:-}"
if [ -z "$NODE_IP" ]; then
    NODE_IP=$(ip -4 -o addr show scope global | grep -v docker | awk '{print $4}' | cut -d/ -f1 | head -1)
fi
if [ -z "$NODE_IP" ]; then
    echo "Не удалось определить IP, передай его первым аргументом"
    exit 1
fi
log "IP ноды: $NODE_IP"

log "Ищу живые ноды среди известных: ${KNOWN_NODES[*]}"
LIVE_NODES=()
for host in "${KNOWN_NODES[@]}"; do
    if [ "$host" = "$NODE_IP" ]; then
        continue
    fi
    log "Проверяю $host:7000"
    if timeout 3 bash -c "echo > /dev/tcp/$host/7000" 2>/dev/null; then
        log "$host:7000 OK"
        LIVE_NODES+=("$host")
    else
        log "$host:7000 недоступен, пропускаю"
    fi
done

if [ ${#LIVE_NODES[@]} -eq 0 ]; then
    echo "Ни одна известная нода не отвечает на порту 7000."
    echo "Присоединиться некуда: либо весь кластер лёг, либо это первая нода кластера."
    echo "Если это первая нода нового кластера, укажи SEEDS вручную и стартуй без этого скрипта."
    exit 1
fi

# Двух живых достаточно для seeds, остальные не нужны в самом конфиге ноды.
# Но проверяем по всему известному списку, чтобы не зависеть от конкретных двух адресов.
SEEDS=$(printf "%s," "${LIVE_NODES[@]:0:2}")
SEEDS="${SEEDS%,}"
log "Использую seeds: $SEEDS"

log "Отключаю swap"
swapoff -a
sed -i '/ swap / s/^/#/' /etc/fstab

log "Настраиваю sysctl"
tee /etc/sysctl.d/99-cassandra.conf > /dev/null <<'SYSCTL'
vm.max_map_count = 1048575
vm.swappiness = 1
net.ipv4.tcp_keepalive_time = 300
SYSCTL
sysctl -p /etc/sysctl.d/99-cassandra.conf > /dev/null

log "Настраиваю время"
export DEBIAN_FRONTEND=noninteractive
apt update -qq
timedatectl set-timezone UTC
apt install -y -qq systemd-timesyncd
systemctl enable --now systemd-timesyncd

log "Готовлю каталог данных"
mkdir -p /opt/cassandra/data
chown -R 999:999 /opt/cassandra/data

if ! command -v docker &> /dev/null; then
    log "Устанавливаю Docker"
    apt install -y -qq ca-certificates curl gnupg
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
    apt update -qq
    apt install -y -qq docker-ce docker-ce-cli containerd.io docker-compose-plugin
    systemctl enable --now docker
else
    log "Docker уже установлен"
fi

RAM_MB=$(free -m | awk '/^Mem:/{print $2}')
HEAP_MB=$(( RAM_MB / 4 ))
[ $HEAP_MB -gt 8192 ] && HEAP_MB=8192
HEAP_NEW_MB=$(( HEAP_MB / 5 ))
log "RAM ${RAM_MB}M, heap ${HEAP_MB}M"

log "Пишу конфигурацию"
cat > /opt/cassandra/docker-compose.yml <<'COMPOSE'
services:
  cassandra:
    image: cassandra:4.1
    container_name: cassandra
    restart: unless-stopped
    network_mode: host
    environment:
      CASSANDRA_CLUSTER_NAME: ${CLUSTER_NAME}
      CASSANDRA_DC: ${DC}
      CASSANDRA_RACK: ${RACK}
      CASSANDRA_ENDPOINT_SNITCH: GossipingPropertyFileSnitch
      CASSANDRA_SEEDS: ${SEEDS}
      CASSANDRA_LISTEN_ADDRESS: ${NODE_IP}
      CASSANDRA_BROADCAST_ADDRESS: ${NODE_IP}
      CASSANDRA_RPC_ADDRESS: ${NODE_IP}
      CASSANDRA_BROADCAST_RPC_ADDRESS: ${NODE_IP}
      MAX_HEAP_SIZE: ${HEAP_SIZE}
      HEAP_NEWSIZE: ${HEAP_NEW}
    volumes:
      - /opt/cassandra/data:/var/lib/cassandra
    ulimits:
      memlock: -1
      nofile: 100000
      nproc: 32768
COMPOSE

cat > /opt/cassandra/.env <<ENV
NODE_IP=${NODE_IP}
CLUSTER_NAME=${CLUSTER_NAME}
DC=${DC}
RACK=${RACK}
SEEDS=${SEEDS}
HEAP_SIZE=${HEAP_MB}M
HEAP_NEW=${HEAP_NEW_MB}M
ENV

log "Запускаю контейнер"
cd /opt/cassandra
docker compose up -d

log "Жду перехода в NORMAL"
DEADLINE=$(( SECONDS + 3600 ))
while [ $SECONDS -lt $DEADLINE ]; do
    if docker exec cassandra nodetool netstats 2>/dev/null | head -1 | grep -q "Mode: NORMAL"; then
        log "Готово, нода в NORMAL"
        docker exec cassandra nodetool status
        exit 0
    fi
    sleep 15
done

log "Не дождались NORMAL за час, проверь вручную: docker exec cassandra nodetool status"
exit 1
